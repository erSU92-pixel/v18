# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ── APEX QUANT v19.0 (XAUUSD Python Engine) ─────────────────────────────────
# Market Data Providers (OANDA v20 Tier-1 -> TwelveData Tier-2 -> Yahoo Spot -> Yahoo Futures)
OANDA_API_KEY=""
OANDA_ACCOUNT_ID=""
OANDA_ENV="practice"               # "practice" or "live"
TWELVE_DATA_API_KEY=""

# Execution Mode ("signal_only" for Telegram/MT5 alerts, "oanda" for automated OANDA LIMIT orders)
APEX_EXECUTION_MODE="signal_only"

# Telegram Alerts
TELEGRAM_TOKEN=""
TELEGRAM_CHAT_ID=""

# GitHub Gist Cloud State Persistence
GIST_ID=""
GIST_TOKEN=""

# Capital & Risk Parameters
APEX_SYMBOL="XAUUSD"
APEX_BALANCE="1000.0"
APEX_RISK_PCT="1.0"
APEX_MAX_DAILY_LOSS="3.0"
APEX_MAX_CONSEC_LOSSES="3"
APEX_MT5_OFFSET="0.0"

# Operational Flags
APEX_DRY_RUN="true"
APEX_KILL_SWITCH="false"
APEX_SKIP_KILLZONE_FILTER="false"
APEX_SKIP_ROLLOVER_FILTER="false"
APEX_ENABLE_ML="true"
APEX_ALLOW_RANGING="true"
APEX_ENFORCE_HTF_FILTER="true"
APEX_NEWS_FAIL_CLOSED="false"
